# Config is left as exports as to allow environment variable support in VMs.

# Require senders be approved. Note the email server is presumed to authenticate senders on the bot's behalf.
# Allowlist is one line per entry, plaintext. @domain.tld without a user will be treated as a wildcard for that domain.
export SENDER_ALLOWLIST=false

# SMTP information for sending mail replies
export SMTP_SERVER=
export SMTP_PORT=
export SMTP_USER=
export SMTP_PASS=

# POP mail settings. IMAP is disabled by default, as POP lets us cleanup the dangerzone inbox natively helping prevent duplication without a local DB.
# We can instead override this and use IMAP; when using IMAP use the POP variables as normal but point to the IMAP service.
# If SMTP and POP server+authentication are identical, the bot will attempt to use the SMTP credentials if POP credentials are not populated.
# POP_CADENCE defines how often we check the inbox, defined in seconds. Emails within that time window will be pulled at once and queued.
# If POP fails to be checked whilst the bot is running, the cadence time will stack to ensure emails received outside the window are included in the queue.
# With IMAP this may lead to inadvertant duplicates as to avoid keeping a local database of emails processed in the initial release.
export IMAP_OVERRIDE=false
export POP_CADENCE=30
export POP_SERVER=
export POP_PORT=
export POP_USER=
export POP_PASS=

# Subject prefix in the bot reply. Filename and date will be automatically added unless hidden.
export EMAIL_SUBJECT_PREFIX="Dangerzone File"

# Choose to make the file name a generic output rather than the original file name.
# Useful for notification privacy but loses convenience and makes downloads of resulting files less organized.
export DANGERZONE_FILENAME_SANITIZATION=false

# CLI Options to use with Dangerzone. File path etc will be handled automatically.
export DANGERZONE_CLI_OPTIONS=

# Keep input or output files; defined in minutes. 0 is immediate deletion after processing/sending response.
export DANGERZONE_INPUT_RETENTION=0
export DANGERZONE_OUTPUT_RETENTION=0
